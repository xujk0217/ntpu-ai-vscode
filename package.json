{
  "name": "ntpu-ai-coder",
  "displayName": "NTPU AI Agent",
  "description": "Use your NTPU AI browser session to read and edit a local VS Code workspace.",
  "version": "0.6.25",
  "publisher": "ntpu-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20.9"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./src/main.js",
  "activationEvents": [
    "onView:ntpuAI.chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "ntpuAI.open",
        "title": "NTPU AI: 開啟程式助理"
      },
      {
        "command": "ntpuAI.login",
        "title": "NTPU AI: 連線（VS Code 背景）"
      },
      {
        "command": "ntpuAI.logout",
        "title": "NTPU AI: 登出並清除本機登入資料"
      },
      {
        "command": "ntpuAI.openAgentSettings",
        "title": "NTPU AI: 編輯專案 Agent 設定檔"
      },
      {
        "command": "ntpuAI.importAgentSettings",
        "title": "NTPU AI: 套用 Agent 設定檔"
      },
      {
        "command": "ntpuAI.exportAgentSettings",
        "title": "NTPU AI: 匯出目前 Agent 設定"
      },
      {
        "command": "ntpuAI.status",
        "title": "NTPU AI: 檢查連線"
      },
      {
        "command": "ntpuAI.askSelection",
        "title": "NTPU AI: 詢問選取的程式碼"
      },
      {
        "command": "ntpuAI.stop",
        "title": "NTPU AI: 停止"
      },
      {
        "command": "ntpuAI.testConcurrency",
        "title": "NTPU AI: 選用並行診斷（2–4，不影響動態排程）"
      },
      {
        "command": "ntpuAI.checkForUpdates",
        "title": "NTPU AI: 檢查更新"
      },
      {
        "command": "ntpuAI.installUpdate",
        "title": "NTPU AI: 下載並安裝更新"
      },
      {
        "command": "ntpuAI.enablePlugin",
        "title": "NTPU AI: 啟用外部 Agent 橋接"
      },
      {
        "command": "ntpuAI.exportPlugin",
        "title": "NTPU AI: 匯出本機 Plugin／MCP 設定"
      },
      {
        "command": "ntpuAI.disablePlugin",
        "title": "NTPU AI: 停用外部 Agent 橋接"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ntpuAI.askSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ntpuAI",
          "title": "NTPU AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ntpuAI": [
        {
          "type": "webview",
          "id": "ntpuAI.chat",
          "name": "Agent"
        }
      ]
    },
    "configuration": {
      "title": "NTPU AI Coder",
      "properties": {
        "ntpuAI.chat.submitMode": {
          "type": "string",
          "enum": [
            "enter",
            "modifierEnter"
          ],
          "default": "enter",
          "scope": "application",
          "description": "聊天送出快捷鍵。Enter 模式下 Enter 送出、Shift+Enter 換行；修飾鍵模式下 Enter 換行、Ctrl/⌘+Enter 送出。輸入法組字時不會誤送。"
        },
        "ntpuAI.chromePath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Chrome 執行檔路徑；留空自動偵測。",
          "deprecationMessage": "請改用 ntpuAI.browser=custom 與 ntpuAI.customBrowserPath。舊設定仍相容。"
        },
        "ntpuAI.browserProfilePath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "獨立 browser-profiles 根目錄；留空使用 VS Code 私有儲存區。根目錄下依瀏覽器隔離，不允許日常瀏覽器或專案資料目錄。"
        },
        "ntpuAI.maxSteps": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 200,
          "description": "主 Agent、子 Agent 與取名共用的模型請求輪數，預設 100，可設為 1–200；標準與深入模式均使用此設定，快速模式最多 12 輪。停止、登入失效及服務限制仍立即停止。"
        },
        "ntpuAI.responseTimeoutSeconds": {
          "type": "integer",
          "default": 240,
          "minimum": 30,
          "maximum": 600,
          "description": "模型連續沒有新回答內容的等待秒數；收到內容會延長閒置等待，單次總上限為四倍、最多 15 分鐘。一般失敗依共用 Queue 最多恢復兩次；登入及服務限制立即停止。"
        },
        "ntpuAI.contextCharacters": {
          "type": "integer",
          "default": 64000,
          "minimum": 16000,
          "maximum": 100000,
          "description": "每次模型請求的上下文字元預算；本機完整歷史不會因此截斷。"
        },
        "ntpuAI.skillDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "額外的使用者 skills 資料夾絕對路徑。"
        },
        "ntpuAI.terminal.enableAutoApprove": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "允許基本唯讀指令及自訂規則自動執行。停用後，每個終端機指令都需要核准。"
        },
        "ntpuAI.terminal.autoApprove": {
          "type": "object",
          "default": {},
          "scope": "application",
          "additionalProperties": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "markdownDescription": "自訂指令開頭或以 / 包住的 ^ 開頭正規表示式。true 自動核准；false 必須核准且優先於完整存取。例：\"npm run build\": true、\"rm\": false。非完整存取模式的複合指令及 shell 展開仍需核准。"
        },
        "ntpuAI.memory.enableProject": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "將相關 Project Memory 帶入模型脈絡；本機 Session 歷史仍持續保存。"
        },
        "ntpuAI.memory.autoUpdate": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "根據實際工具結果更新專案記憶，不發送額外模型請求。"
        },
        "ntpuAI.privacy.reviewPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "傳送前需單次核准的相對路徑 glob。Protected 路徑與秘密遮蔽無法透過此設定停用。"
        },
        "ntpuAI.browser": {
          "type": "string",
          "enum": [
            "auto",
            "chrome",
            "edge",
            "chromium",
            "custom"
          ],
          "enumDescriptions": [
            "自動偵測並確認 Playwright 控制成功",
            "Google Chrome",
            "Microsoft Edge",
            "Chromium",
            "自訂 Chromium 執行檔"
          ],
          "default": "auto",
          "scope": "application",
          "description": "瀏覽器選擇；不同瀏覽器的專用 profile 相互隔離。"
        },
        "ntpuAI.customBrowserPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Custom 模式的 Chromium 瀏覽器執行檔絕對路徑。"
        },
        "ntpuAI.attachments.ocr": {
          "type": "object",
          "scope": "application",
          "default": {
            "language": "eng"
          },
          "description": "本機附件 OCR；預設英文在沒有原生 Tesseract 時使用隨包離線 WASM。PDF 仍需 Poppler；可指定 language、tesseract、pdfinfo、pdftotext、pdftoppm，不存入辨識文字。",
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "string"
            },
            "tesseract": {
              "type": "string"
            },
            "pdfinfo": {
              "type": "string"
            },
            "pdftotext": {
              "type": "string"
            },
            "pdftoppm": {
              "type": "string"
            }
          }
        },
        "ntpuAI.parallel.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "啟用唯讀子任務與批次工具。模型請求從 2 開始依多筆回應在 1–4 動態調整，不需事先測試。"
        },
        "ntpuAI.parallel.maxConcurrency": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3,
            4
          ],
          "default": 0,
          "scope": "application",
          "description": "動態模型請求的最高值，0 為自動（最多 4）；可以調低，服務限制會暫停新請求。"
        },
        "ntpuAI.browser.cleanupTaskConversations": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "本機儲存任務後，透過校方網站刪除擴充套件自己建立的任務對話。校方後端保留政策仍適用；不刪除原有對話。"
        },
        "ntpuAI.parallel.probeMaxConcurrency": {
          "type": "integer",
          "enum": [
            2,
            3,
            4
          ],
          "default": 4,
          "scope": "application",
          "description": "選用診斷的最高請求數（2–4），不影響正式任務的動態並行控制；遇到失敗停止，不自動重試。"
        },
        "ntpuAI.parallel.probeIntervalSeconds": {
          "type": "integer",
          "enum": [
            0,
            30,
            60,
            90,
            120
          ],
          "default": 60,
          "scope": "application",
          "description": "成功組之間的等待秒數，預設 60，降低累積請求觸發分鐘限制的機率；不是失敗後重試。遇到 429／服務限制立即停止，必須使用者再次手動啟動新的測試。"
        },
        "ntpuAI.parallel.requestsPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 8,
          "scope": "application",
          "description": "本機模型請求節奏，預設每分鐘最多 8 次（可調低或最高 10）；超出本機額度先等待，不重送失敗請求。校方及其他視窗的用量限制仍優先，429 仍立即停止。"
        },
        "ntpuAI.updates.autoCheck": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "啟用後自動檢查 GitHub 正式版本並提醒；不會自動安裝或重新載入。每 24 小時至多自動查詢一次，可隨時手動檢查。"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.ntpu-ai.json",
          "**/*.ntpu-ai.json"
        ],
        "url": "./schemas/agent-settings.schema.json"
      }
    ]
  },
  "scripts": {
    "test": "node scripts/test.js",
    "smoke": "node scripts/browser-smoke.js",
    "package": "npm run build && node scripts/package.js",
    "build": "node scripts/build-ui.js",
    "mcp:smoke": "node scripts/mcp-smoke.js",
    "browser:fixture": "node scripts/browser-fixture.js",
    "sandbox:fixture": "node scripts/sandbox-fixture.js",
    "ocr:fixture": "node scripts/ocr-fixture.js",
    "computer:fixture": "node scripts/computer-fixture.js",
    "desktop:fixture": "node scripts/desktop-fixture.js",
    "plugin:package": "npm run build && python3 scripts/package-plugin.py",
    "capabilities:fixture": "node scripts/bundled-capabilities-fixture.js",
    "desktop:macos:build": "node scripts/build-macos-desktop.js",
    "desktop:macos:fixture": "node scripts/build-macos-desktop.js && node scripts/macos-desktop-fixture.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tesseract.js-data/eng": "1.0.0",
    "diff": "9.0.0",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "katex": "0.19.0",
    "markdown-it": "15.0.2",
    "markdown-it-cjk-friendly": "3.0.0",
    "playwright-core": "1.64.0",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@vscode/vsce": "3.2.2",
    "esbuild": "0.25.12"
  },
  "author": "許君愷",
  "repository": {
    "type": "git",
    "url": "https://github.com/xujk0217/ntpu-ai-vscode.git"
  },
  "homepage": "https://github.com/xujk0217/ntpu-ai-vscode#readme",
  "bugs": {
    "url": "https://github.com/xujk0217/ntpu-ai-vscode/issues"
  },
  "extensionKind": [
    "ui"
  ],
  "optionalDependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79"
  }
}
