{
  "name": "ntpu-ai-coder",
  "displayName": "NTPU AI Agent",
  "description": "Use your NTPU AI browser session to read and edit a local VS Code workspace.",
  "version": "0.6.0",
  "publisher": "ntpu-local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20.9"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./src/main.js",
  "activationEvents": [
    "onView:ntpuAI.chat"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "ntpuAI.open",
        "title": "NTPU AI: 開啟程式助理"
      },
      {
        "command": "ntpuAI.login",
        "title": "NTPU AI: 連線（VS Code 背景）"
      },
      {
        "command": "ntpuAI.logout",
        "title": "NTPU AI: 登出並清除本機登入資料"
      },
      {
        "command": "ntpuAI.status",
        "title": "NTPU AI: 檢查連線"
      },
      {
        "command": "ntpuAI.askSelection",
        "title": "NTPU AI: 詢問選取的程式碼"
      },
      {
        "command": "ntpuAI.stop",
        "title": "NTPU AI: 停止"
      },
      {
        "command": "ntpuAI.testConcurrency",
        "title": "NTPU AI: 測試兩個聊天室同時回覆"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ntpuAI.askSelection",
          "when": "editorHasSelection",
          "group": "navigation@20"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ntpuAI",
          "title": "NTPU AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ntpuAI": [
        {
          "type": "webview",
          "id": "ntpuAI.chat",
          "name": "Agent"
        }
      ]
    },
    "configuration": {
      "title": "NTPU AI Coder",
      "properties": {
        "ntpuAI.chromePath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Chrome 執行檔路徑；留空自動偵測。",
          "deprecationMessage": "請改用 ntpuAI.browser=custom 與 ntpuAI.customBrowserPath。舊設定仍相容。"
        },
        "ntpuAI.browserProfilePath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "獨立 browser-profiles 根目錄；留空使用 VS Code 私有儲存區。根目錄下依瀏覽器隔離，不允許日常瀏覽器或專案資料目錄。"
        },
        "ntpuAI.maxSteps": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 100,
          "description": "每次任務最多工具輪數，預設 50，上限 100；快速／標準／深入最多 12／50／100 輪。"
        },
        "ntpuAI.responseTimeoutSeconds": {
          "type": "integer",
          "default": 240,
          "minimum": 30,
          "maximum": 600,
          "description": "每次網站回答最長等待秒數。逾時不自動重送。"
        },
        "ntpuAI.contextCharacters": {
          "type": "integer",
          "default": 64000,
          "minimum": 16000,
          "maximum": 100000,
          "description": "每次模型請求的上下文字元預算；本機完整歷史不會因此截斷。"
        },
        "ntpuAI.skillDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "額外的使用者 skills 資料夾絕對路徑。"
        },
        "ntpuAI.terminal.enableAutoApprove": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "允許基本唯讀指令及自訂規則自動執行。停用後，每個終端機指令都需要核准。"
        },
        "ntpuAI.terminal.autoApprove": {
          "type": "object",
          "default": {},
          "scope": "application",
          "additionalProperties": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "markdownDescription": "自訂指令開頭或以 / 包住的 ^ 開頭正規表示式。true 自動核准；false 必須核准且優先於完整存取。例：\"npm run build\": true、\"rm\": false。非完整存取模式的複合指令及 shell 展開仍需核准。"
        },
        "ntpuAI.memory.enableProject": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "將相關 Project Memory 帶入模型脈絡；本機 Session 歷史仍持續保存。"
        },
        "ntpuAI.memory.autoUpdate": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "根據實際工具結果更新專案記憶，不發送額外模型請求。"
        },
        "ntpuAI.privacy.reviewPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "application",
          "description": "傳送前需單次核准的相對路徑 glob。Protected 路徑與秘密遮蔽無法透過此設定停用。"
        },
        "ntpuAI.browser": {
          "type": "string",
          "enum": [
            "auto",
            "chrome",
            "edge",
            "chromium",
            "custom"
          ],
          "enumDescriptions": [
            "自動偵測並確認 Playwright 控制成功",
            "Google Chrome",
            "Microsoft Edge",
            "Chromium",
            "自訂 Chromium 執行檔"
          ],
          "default": "auto",
          "scope": "application",
          "description": "瀏覽器選擇；不同瀏覽器的專用 profile 相互隔離。"
        },
        "ntpuAI.customBrowserPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Custom 模式的 Chromium 瀏覽器執行檔絕對路徑。"
        },
        "ntpuAI.attachments.ocr": {
          "type": "object",
          "scope": "application",
          "default": {
            "language": "eng"
          },
          "description": "本機附件 OCR。可指定 language、tesseract、pdfinfo、pdftotext、pdftoppm 執行檔；不存入辨識文字。",
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "string"
            },
            "tesseract": {
              "type": "string"
            },
            "pdfinfo": {
              "type": "string"
            },
            "pdftotext": {
              "type": "string"
            },
            "pdftoppm": {
              "type": "string"
            }
          }
        },
        "ntpuAI.parallel.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "啟用獨立唯讀工具批次與子任務。模型並行只在近期測試通過後啟用。"
        },
        "ntpuAI.parallel.maxConcurrency": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "default": 2,
          "scope": "application",
          "description": "最多同時模型請求數。未驗證、登入失效或超過一天時使用 1。"
        }
      }
    }
  },
  "scripts": {
    "test": "node scripts/test.js",
    "smoke": "node scripts/browser-smoke.js",
    "package": "npm run build && node scripts/package.js",
    "build": "node scripts/build-ui.js",
    "mcp:smoke": "node scripts/mcp-smoke.js",
    "browser:fixture": "node scripts/browser-fixture.js",
    "sandbox:fixture": "node scripts/sandbox-fixture.js",
    "ocr:fixture": "node scripts/ocr-fixture.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "diff": "9.0.0",
    "highlight.js": "11.12.0",
    "jsonc-parser": "3.3.1",
    "markdown-it": "15.0.2",
    "playwright-core": "1.64.0",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.2.2",
    "esbuild": "0.25.12"
  },
  "author": "許君愷",
  "repository": {
    "type": "git",
    "url": "https://github.com/xujk0217/ntpu-ai-vscode.git"
  },
  "homepage": "https://github.com/xujk0217/ntpu-ai-vscode#readme",
  "bugs": {
    "url": "https://github.com/xujk0217/ntpu-ai-vscode/issues"
  },
  "extensionKind": [
    "ui"
  ],
  "optionalDependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79"
  }
}
